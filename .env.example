# Copy the Firebase web app configuration from Project settings > General.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional local emulators; honored only by Vite's development build.
VITE_FIREBASE_USE_EMULATORS=false

# Optional dedicated Firebase accounts for manual E2E runs.
# Automated emulator/integration runners create and clean up their own accounts.
E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=
E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=
